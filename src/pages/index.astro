---
import MainGridLayout from "../layouts/MainGridLayout.astro";

const highlights = [
	{
		name: "AgentOS",
		tag: "Agent 运行时",
		desc: "任务只有在验证命令通过 + 独立评审 PASS 后才算完成，模型无法自证。我做了对照实验证明这道闸门真的拦得住。",
		href: "/projects/#agentos",
	},
	{
		name: "skillc",
		tag: "Skill 编译器",
		desc: "一份 Skill 源码编译到 4 个 Agent 底盘。产物哈希各不相同，证明是按目标定制而非复制；手工改动会被拒绝覆盖。",
		href: "/projects/#skillc",
	},
	{
		name: "RailMind",
		tag: "数据 + 机器学习",
		desc: "321 万条数据的全链路 ML Pipeline。识别出 R²=1.0 是数据泄漏的假象，定位 3 个泄漏特征并修复。",
		href: "/projects/#railmind",
	},
];

const skillGroups = [
	{
		label: "大模型 / Agent 工程",
		items: [
			"OpenAI-compatible 协议",
			"tool-calling 循环",
			"Agent 运行时",
			"MCP Server",
			"Skill 编译与蒸馏",
			"多 Agent 协作编排",
		],
	},
	{
		label: "数据 / 机器学习",
		items: [
			"特征工程与泄漏排查",
			"scikit-learn",
			"XGBoost / LightGBM",
			"PyTorch",
			"Kafka + Flink",
		],
	},
	{
		label: "工程基础",
		items: [
			"Python · FastAPI",
			"TypeScript · Node.js",
			"PostgreSQL · Redis",
			"Docker Compose",
			"Vue · React · Tailwind",
		],
	},
];
---

<MainGridLayout title="谢键禧 - 个人主页" description="AI 应用开发 · 大模型 Agent 方向">
<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
<div class="card-base z-10 px-9 py-8 relative w-full text-90">

<!-- Hero -->
<div class="mb-10">
<h1 class="text-4xl font-bold mb-2">谢键禧</h1>
<div class="text-lg mb-4">AI 应用开发 · 大模型 Agent 方向</div>
<p class="leading-relaxed max-w-3xl">
大数据技术专业在读，但近两年的主要精力在大模型应用工程上，
集中在 <strong>Agent 运行时</strong>与 <strong>Skill 工程</strong>两条线。
我习惯用可验证的方式做项目——跑起来、做对照实验、把难看的数字也写清楚。
</p>
<div class="flex flex-wrap gap-3 mt-5">
<a href="/about/" class="px-4 py-2 rounded-lg bg-[var(--primary)] text-white text-sm font-bold hover:opacity-90 transition-opacity">
查看简历
</a>
<a href="/projects/" class="px-4 py-2 rounded-lg border border-[var(--line-divider)] text-sm font-bold hover:border-[var(--primary)] transition-colors">
作品集（9 个项目）
</a>
<a href="https://github.com/laolaola278-dev" target="_blank" rel="noopener" class="px-4 py-2 rounded-lg border border-[var(--line-divider)] text-sm font-bold hover:border-[var(--primary)] transition-colors">
GitHub
</a>
</div>
</div>

<!-- 核心能力 -->
<h2 class="text-xl font-bold mb-4">核心能力</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
{skillGroups.map((g) => (
<div class="p-4 rounded-lg border border-[var(--line-divider)]">
<div class="font-bold mb-3 text-sm">{g.label}</div>
<div class="flex flex-wrap gap-1.5">
{g.items.map((i) => (
<span class="text-xs px-2 py-1 rounded bg-[var(--codeblock-bg)]">{i}</span>
))}
</div>
</div>
))}
</div>

<!-- 亮点项目 -->
<h2 class="text-xl font-bold mb-1">亮点项目</h2>
<p class="text-sm mb-4">完整 9 个项目见<a href="/projects/" class="text-[var(--primary)] underline ml-1">作品集</a></p>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
{highlights.map((h) => (
<a href={h.href} class="block p-5 rounded-lg border border-[var(--line-divider)] hover:border-[var(--primary)] transition-colors">
<div class="font-bold mb-1">{h.name}</div>
<div class="text-xs mb-3">{h.tag}</div>
<p class="text-sm leading-relaxed">{h.desc}</p>
</a>
))}
</div>

<!-- 验证说明 -->
<div class="border-l-4 border-[var(--primary)] bg-[var(--codeblock-bg)] rounded-r-lg px-5 py-4">
<p class="font-bold mb-2">关于这个站点</p>
<p class="text-sm leading-relaxed">
作品集里的每个项目都标注了<strong>验证状态</strong>：哪些我实机跑过并留下了运行记录，
哪些是项目自带的真实截图，哪些只做了代码审计，哪些是二次开发。
<strong>我没有为任何项目伪造运行截图。</strong>
</p>
<p class="text-sm mt-2">
本站基于 <a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener" class="underline">Fuwari</a> 模板构建。
</p>
</div>

</div>
</div>
</MainGridLayout>
